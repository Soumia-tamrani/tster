generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String               @id @default(uuid())
  firstName              String
  lastName               String
  email                  String               @unique
  phone                  String               @unique
  city                   String
  country                String
  role                   UserRole
  referralSource         ReferralSource?
  parrainId              String?
  createdAt              DateTime             @default(now())
  subscribedToNewsletter Boolean              @default(false)
  ipAddress              String?
  registeredForTrial     Boolean              @default(false)
  registrationDate       DateTime?
  emailVerified          Boolean?
  entrepriseProfile      EntrepriseProfile?
  professionalProfile    ProfessionalProfile?
  parrain                User?                @relation("Parrainage", fields: [parrainId], references: [id])
  filleuls               User[]               @relation("Parrainage")
}

model ProfessionalProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  secteur       Secteur
  centreInteret String
  user          User    @relation(fields: [userId], references: [id])
}

model EntrepriseProfile {
  id            String      @id @default(uuid())
  userId        String      @unique
  companyName   String
  companySize   CompanySize
  roleInCompany String
  secteur       Secteur
  besoin        String
  site          String?
  user          User        @relation(fields: [userId], references: [id])
}

model CookieConsent {
  id            String   @id @default(cuid())
  userId        String?
  sessionId     String
  consentStatus String
  consentDate   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserRole {
  PROFESSIONAL
  ENTREPRISE
}

enum CompanySize {
  STARTUP
  PME
  GRANDE_ENTREPRISE
}

enum Secteur {
  TECHNOLOGIE
  AGRO_HALIEUTIQUE
  COMMERCE
  FINANCE
  SANTE
  ENERGIE_DURABILITE
  TRANSPORT
  INDUSTRIE
  COMMERCE_DISTRIBUTION
  SERVICES_PROFESSIONNELS
  TOURISME
  MEDIA_DIVERTISSEMENT
  EDUCATION
  AUTRE
}

enum ReferralSource {
  RESEAUX_SOCIAUX
  RECHERCHE_EN_LIGNE
  RECOMMANDATION
  PUBLICITE
  AUTRE
}
